# Custom PHP settings
php_value max_input_vars 3000
php_value upload_max_filesize 50M
php_value post_max_size       55M
php_value memory_limit        512M
php_value max_execution_time  300

# Session lifetime — keep admins logged in for a full work day so long edit
# sessions on add_drive / form-fields / round-results pages don't get bounced
# back to the login page after the default ~24-minute idle timeout.
# 28800s = 8 hours.
php_value session.gc_maxlifetime 28800
php_value session.cookie_lifetime 28800
php_value session.gc_probability 1
php_value session.gc_divisor     1000

# Enable mod_rewrite
RewriteEngine On

# Hide .php extension in browser URLs.
# Only redirect GET requests — redirecting POST causes browsers to retry as GET
# and drop the body, breaking AJAX endpoints like block_student.php.
RewriteCond %{THE_REQUEST} ^GET\s([^.]+)\.php\sHTTP/
RewriteRule ^ %1 [R=301,L]


# Route /student_form and /student_form/... to student_form.php and pass extra path as PATH_INFO
RewriteRule ^student_form(/.*)?$ student_form.php$1 [L,QSA]


# Internally route URLs like /dashboard to dashboard.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)$ $1.php [L]

# === Compression — saves a lot of bandwidth on tables / JSON responses ===
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

# === Browser caching of static assets so repeat page loads feel instant ===
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 7 days"
    ExpiresByType application/javascript   "access plus 7 days"
    ExpiresByType text/javascript          "access plus 7 days"
    ExpiresByType image/png                "access plus 30 days"
    ExpiresByType image/jpeg               "access plus 30 days"
    ExpiresByType image/gif                "access plus 30 days"
    ExpiresByType image/svg+xml            "access plus 30 days"
    ExpiresByType image/webp               "access plus 30 days"
    ExpiresByType image/x-icon             "access plus 30 days"
    ExpiresByType font/woff                "access plus 30 days"
    ExpiresByType font/woff2               "access plus 30 days"
    ExpiresByType application/pdf          "access plus 7 days"
    ExpiresDefault                         "access plus 1 hour"
</IfModule>

# === Defensive headers: don't break, but improve resilience ===
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy        "strict-origin-when-cross-origin"
    Header set X-Frame-Options        "SAMEORIGIN"
    # Static assets: opt-in to long cache + immutable for fingerprintable types.
    <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
</IfModule>

# === Block direct access to sensitive paths ===
<FilesMatch "^(config\.php|error_handler\.php|placed_import_helper\.php|backup_engine\.php|auto_backup\.php|sync_placed_students\.php|.+\.sql|.+\.log|composer\.(json|lock))$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
RedirectMatch 403 ^/(backups|logs)/

# Lock down dot-files like .env, .git, .htaccess itself.
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>
